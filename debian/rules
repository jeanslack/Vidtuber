#!/usr/bin/make -f
: # *-* makefile *-*

# You must remove unused comment lines for the released package.

export DH_VERBOSE = 1
export PYBUILD_NAME = vidtuber

%:
	dh $@ --with python3 --buildsystem=pybuild

# This block intercepts the build before pybuild/hatch is configured.
override_dh_auto_configure:
	@DISTRO=$$(lsb_release -is); \
	RELEASE=$$(lsb_release -cs); \
	echo "Detected distribution: $$DISTRO ($$RELEASE)"; \
	if [ "$$DISTRO" = "Ubuntu" ] && [ "$$RELEASE" = "noble" ]; then \
		echo "Cleaning Python 3.14 and 3.15 classifiers for Ubuntu Noble..."; \
		sed -i '/Programming Language :: Python :: 3.14/d' pyproject.toml; \
		sed -i '/Programming Language :: Python :: 3.15/d' pyproject.toml; \
	elif [ "$$DISTRO" = "Debian" ]; then \
		echo "Cleaning Python 3.15 classifier for Debian..."; \
		sed -i '/Programming Language :: Python :: 3.15/d' pyproject.toml; \
	fi
	dh_auto_configure
