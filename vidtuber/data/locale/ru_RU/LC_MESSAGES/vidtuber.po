"Leave the text field blank for direct connection."
msgstr ""
"Используйте указанный прокси-сервер HTTP/HTTPS/SOCKS. \n"
"Чтобы включить прокси-сервер SOCKS, укажите правильную схему, например\t{}\n"
"Оставьте текстовое поле пустым для прямого подключения."

#: vidtuber/vt_dialogs/settings_ytdlp.py:181
msgid "Proxy"
msgstr "Proxy"

#: vidtuber/vt_dialogs/settings_ytdlp.py:189
msgid "Timeouts and Retries"
msgstr ""

#: vidtuber/vt_dialogs/settings_ytdlp.py:192
msgid "Settings for network timeout before failure, the maximum number of attempts to complete a download, and the maximum number of attempts for individual fragments (HLS/DASH)"
msgstr ""

#: vidtuber/vt_dialogs/settings_ytdlp.py:200
msgid "Timeout"
msgstr ""

#: vidtuber/vt_dialogs/settings_ytdlp.py:207
msgid "Sets the maximum wait time (in seconds) before yt-dlp considers a connection to be stalled and terminates it due to server inactivity. Default is 20 seconds."
msgstr ""

#: vidtuber/vt_dialogs/settings_ytdlp.py:213
msgid "Retries"
msgstr ""

#: vidtuber/vt_dialogs/settings_ytdlp.py:221
msgid "Sets how many times to retry starting or resuming the download if the connection drops or the server returns a transient error. Default is 10 times; 0 means infinite."
msgstr ""

#: vidtuber/vt_dialogs/settings_ytdlp.py:227
msgid "Fragment Retries"
msgstr ""

#: vidtuber/vt_dialogs/settings_ytdlp.py:235
msgid "This value determines how many attempts to make for each individual fragment before giving up. This applies only when yt-dlp downloads using DASH, hlsnative, or ISM (formats that are split into fragments). Default is 10 time; 0 means infinite."
msgstr ""

#: vidtuber/vt_dialogs/settings_ytdlp.py:244
msgid "Network"
msgstr "Network"

#: vidtuber/vt_dialogs/settings_ytdlp.py:250
